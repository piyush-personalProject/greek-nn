# Environment
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=risk_system

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# News API
NEWSAPI_KEY=9e5ef2fc98ce47deb0a86fbecb3f24f8

# ML Configuration
NLP_DEVICE=cpu
RISK_NN_DEVICE=cpu
RISK_NN_PATH=./models/risk_nn.onnx
VOL_MODEL_PATH=./models/vol_shock.pkl

# Risk Limits
VEGA_LIMIT=100000
GAMMA_LIMIT=50000
DELTA_LIMIT=500000
RHO_LIMIT=100000
SHOCK_THRESHOLD=0.01

# Feature Flags
ENABLE_NEWS=true
ENABLE_NLP=true
ENABLE_VOL_SHOCK=true
ENABLE_ALERTS=false

# API Server
API_HOST=0.0.0.0
API_PORT=8000